# Copy this file to local.conf in the same directory and edit as needed.
# local.conf is gitignored so private values stay out of the public repo.

# --- DHCP example ---

# Interface that serves DHCP / binds dnsmasq
# interface=eth0

# DHCP pool and lease time
# dhcp-range=192.168.0.2,192.168.0.254,255.255.255.0,12h

# Default gateway advertised to clients (option 3)
# dhcp-option=3,192.168.0.1

# DNS server advertised to clients (option 6).
# Point this at THIS dnsmasq's LAN IP so the Minecraft hostname overrides apply.
# dhcp-option=6,192.168.0.10

# Static lease example
# dhcp-host=AA:BB:CC:DD:EE:FF,192.168.0.16,Hostname,infinite
